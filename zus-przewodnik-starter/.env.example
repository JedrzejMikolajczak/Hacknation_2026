# Port serwera API
PORT=3001
# Dodatkowy dozwolony origin CORS (np. adres demo); http://localhost:5173 jest dozwolony zawsze
CLIENT_ORIGIN=http://localhost:5173
# Token panelu admina (PUT /api/v1/admin/params): min. 32 losowe znaki, np. `openssl rand -hex 32`.
# Pusty lub słaby token (np. change-me) wyłącza zapis parametrów.
ADMIN_TOKEN=
# Klucz API Google Gemini dla asystenta AI w zakładce „Wsparcie” (POST /api/v1/assistant/ask).
# Gdy pusty, serwer zwraca odpowiedzi z lokalnej bazy demonstracyjnej (is_demo_fallback: true).
GEMINI_API_KEY=
# Opcjonalny identyfikator modelu Gemini (domyślnie gemini-3.1-flash-lite).
GEMINI_MODEL=gemini-3.1-flash-lite
